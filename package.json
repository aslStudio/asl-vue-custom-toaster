{
  "name": "asl-vue-custom-toaster",
  "version": "0.1.0",
  "description": "Customizable Vue toast provider with slots and deduplication",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aslStudio/asl-vue-custom-toaster.git"
  },
  "homepage": "https://github.com/aslStudio/asl-vue-custom-toaster#readme",
  "bugs": {
    "url": "https://github.com/aslStudio/asl-vue-custom-toaster/issues"
  },
  "type": "module",
  "license": "asl",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run --cache ./node_modules/.cache/npm",
    "pretest": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
